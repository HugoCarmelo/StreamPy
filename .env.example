# StreamPy Environment Variables
# Copy this file to .env and fill in your values

# Generate with: python -c "from cryptography.fernet import Fernet; import base64, os; key = os.urandom(32); print(base64.b64encode(key).decode())"
ENCRYPTION_KEY=your-32-byte-base64-encoded-key-here

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-jwt-secret-key-here

# Environment: development | production
ENVIRONMENT=production
